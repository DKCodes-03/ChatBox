# syntax=docker/dockerfile:1

# Stage 1 compiles the React/TypeScript application into static browser files. A build stage keeps
# Node.js and development dependencies out of the smaller web-server image below.
FROM node:22-bookworm-slim AS build

WORKDIR /app

# npm ci uses package-lock.json exactly and fails if it disagrees with package.json.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Vite writes the production build to /app/dist.
COPY frontend/ ./
RUN npm run build

# Stage 2 serves only the compiled static files and proxies same-origin API requests.
FROM nginx:1.29-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/proxy.conf /etc/nginx/nginx.conf

# Port 8080 is above the privileged-port range, so nginx can run as its built-in unprivileged user.
USER nginx

EXPOSE 8080

# Bypass the image's root-oriented setup scripts; all required configuration is already copied.
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]

