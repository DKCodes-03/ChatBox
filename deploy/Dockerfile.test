# syntax=docker/dockerfile:1

# The synthetic test profile never loads Sentence Transformers: it uses the deterministic,
# request-scoped embedder in app.testing.embedding. Keeping that optional production dependency
# out of this image prevents CPU-only test runs from downloading multi-gigabyte CUDA libraries.
FROM python:3.12-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN pip install --no-cache-dir \
    "alembic==1.20.0" \
    "beautifulsoup4==4.15.0" \
    "fastapi==0.141.1" \
    "google-genai==2.24.0" \
    "httpx==0.28.1" \
    "numpy==2.5.3" \
    "pgvector==0.5.0" \
    "psycopg[binary]==3.3.6" \
    "pydantic==2.13.5" \
    "pydantic-settings==2.15.0" \
    "pypdf==6.19.0" \
    "pytest==9.0.2" \
    "pytest-asyncio==1.4.0" \
    "sqlalchemy==2.0.54" \
    "uvicorn[standard]==0.53.0"

RUN groupadd --gid 65532 app \
    && useradd --uid 65532 --gid 65532 --create-home --shell /usr/sbin/nologin app

COPY --chown=app:app backend/ ./

ENV HOME=/home/app

USER app

EXPOSE 8000
