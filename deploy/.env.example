# PNW Student Chatbot environment template
#
# Copy this file to deploy/.env before running Docker Compose. This tracked file contains only
# nonsecret settings and paths where containers expect Docker secrets. Never put passwords or API
# keys in this file. Create the referenced secret files outside version control; Compose mounts
# them into only the services that need them.

# -----------------------------------------------------------------------------
# Application mode and public entry point
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_HTTP_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

# The initial architecture intentionally uses one API worker because active conversations live
# only in that worker's memory. Adding workers requires a new approved session design.
API_WORKERS=1

# Never enable content-bearing logs or traces. These switches apply to student questions,
# generated answers, request bodies, URL query strings, cookies, and database parameters.
CHAT_ACCESS_LOG_ENABLED=false
REQUEST_BODY_LOGGING_ENABLED=false
SQL_ECHO=false
TRACE_CONTENT_ENABLED=false

# -----------------------------------------------------------------------------
# PostgreSQL and pgvector
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=pnw_chatbot
POSTGRES_RUNTIME_USER=pnw_chatbot_api
POSTGRES_MIGRATION_USER=pnw_chatbot_migrator
POSTGRES_GOVERNANCE_USER=pnw_chatbot_governance

# These are container paths, not secret values. Use a different password file for each role.
POSTGRES_RUNTIME_PASSWORD_FILE=/run/secrets/postgres_runtime_password
POSTGRES_MIGRATION_PASSWORD_FILE=/run/secrets/postgres_migration_password
POSTGRES_GOVERNANCE_PASSWORD_FILE=/run/secrets/postgres_governance_password

# Host paths used by Docker Compose to create the corresponding read-only secret mounts. Keep the
# containing deploy/secrets directory at mode 0700 and these files at mode 0444 so the non-root
# container users can read their explicitly mounted files without exposing the directory on-host.
POSTGRES_RUNTIME_PASSWORD_HOST_FILE=./secrets/postgres_runtime_password
POSTGRES_MIGRATION_PASSWORD_HOST_FILE=./secrets/postgres_migration_password
POSTGRES_GOVERNANCE_PASSWORD_HOST_FILE=./secrets/postgres_governance_password

# -----------------------------------------------------------------------------
# Generation provider
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
GEMINI_API_KEY_HOST_FILE=./secrets/gemini_api_key
GEMINI_MAX_OUTPUT_TOKENS=512
GENERATION_TIMEOUT_SECONDS=9
GENERATION_MAX_CONCURRENCY=4

# The application must reject production Gemini traffic until the deployment's current provider
# terms and retention behavior have been reviewed and accepted. This is deliberately false here.
GEMINI_PRODUCTION_DATA_HANDLING_APPROVED=false

# Provider requests are stateless. Conversation IDs and provider-side prompt caching stay off.
PROVIDER_CONVERSATION_IDS_ENABLED=false
PROVIDER_PROMPT_CACHE_ENABLED=false

# Optional local llama.cpp fallback. Keep it disabled unless the pinned model file has been
# provisioned and verified for the opt-in Compose profile and read-only model mount.
LOCAL_INFERENCE_ENABLED=false
LOCAL_INFERENCE_BASE_URL=http://inference:8080
LOCAL_INFERENCE_MODEL_PATH=/models/qwen3-4b-q4_k_m.gguf
LOCAL_MODEL_HOST_DIR=./models/local

# -----------------------------------------------------------------------------
# Local embeddings and retrieval
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_HOST_DIR=./models/embeddings
EMBEDDING_MODEL_CACHE_DIR=/models/embeddings
EMBEDDING_DIMENSIONS=384
EVIDENCE_MAX_WORDPIECES=220
RETRIEVAL_MAX_EVIDENCE_BLOCKS=8

# Provision the approved model under EMBEDDING_MODEL_HOST_DIR before startup. These settings make
# model loading use the read-only mount and prevent silent runtime downloads or telemetry.
HF_HOME=/models/embeddings
SENTENCE_TRANSFORMERS_HOME=/models/embeddings
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# -----------------------------------------------------------------------------
# Source discovery and automated qualification
# -----------------------------------------------------------------------------
# Candidate discovery is limited to the supplied corpus and public HTTPS links on these PNW hosts.
SOURCE_ALLOWED_SCHEMES=https
SOURCE_ALLOWED_HOSTS=pnw.edu,www.pnw.edu,catalog.pnw.edu
SOURCE_MAX_CRAWL_DEPTH=3
SOURCE_MAX_URLS_PER_RUN=100
SOURCE_MAX_DOCUMENT_BYTES=20971520

# A source becomes unusable when its latest successful qualification reaches 24 hours old. The
# scheduled refresh uses the same interval, while source effective dates may expire it sooner.
SOURCE_REFRESH_INTERVAL_HOURS=24
QUALIFICATION_MAX_AGE_HOURS=24
MAX_EVIDENCE_BLOCKS=50000

# -----------------------------------------------------------------------------
# Request, session, and admission limits
# -----------------------------------------------------------------------------
SESSION_IDLE_SECONDS=1800
SESSION_WARNING_SECONDS=1680
MAX_ACTIVE_SESSIONS=200
SESSION_MESSAGES_PER_MINUTE=6
MAX_REQUEST_BODY_BYTES=8192
MAX_QUESTION_CHARACTERS=4000

# -----------------------------------------------------------------------------
# Production override guide
# -----------------------------------------------------------------------------
# In a production deploy, override at least APP_ENV, LOG_LEVEL, PUBLIC_HTTP_PORT, PUBLIC_ORIGIN,
# all secret file mounts, and the provider approval/provider mode. Keep the privacy switches false,
# API_WORKERS=1, and the 30-minute session limit unless the approved requirements change.
#
# Example nonsecret production overrides (uncomment only in the untracked deploy/.env file):
# APP_ENV=production
# LOG_LEVEL=WARNING
# PUBLIC_HTTP_PORT=443
# PUBLIC_ORIGIN=https://chat.example.pnw.edu
