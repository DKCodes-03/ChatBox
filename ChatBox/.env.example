# Copy this file to .env before running Docker Compose:
#   cp .env.example .env
#
# These values are development defaults. Do not commit real passwords or
# production secrets to the repository.

POSTGRES_DB=pnw_chatbot
POSTGRES_USER=pnw_chatbot
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000
OLLAMA_PORT=11434

# The backend uses this URL inside Docker. The hostname "db" is the Compose
# service name, not localhost.
DATABASE_URL=postgresql+asyncpg://pnw_chatbot:change-me-for-local-development@db:5432/pnw_chatbot
OLLAMA_BASE_URL=http://ollama:11434
